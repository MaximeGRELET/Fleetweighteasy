# Télémétrie — identifiants publics uniquement, aucun secret.
# Laisser vide désactive proprement la fonctionnalité (voir src/lib/env.ts).
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Contact transmis à Open Food Facts dans le User-Agent (adresse e-mail ou URL).
# Exigé par leur politique d'usage. Laisser vide désactive la recherche et le
# scan en ligne : l'app reste utilisable sur son cache et ses aliments maison.
EXPO_PUBLIC_OFF_CONTACT=
